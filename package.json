{
  "name": "manuscript",
  "version": "2.0.0",
  "entry_script": "dev",
  "scripts": {
    "tsc": "tsc -w",
    "build": "next build",
    "vercel-build": "prisma generate && next build",
    "dev": "next dev",
    "fmt": "prettier --write **/*.{ts,tsx,json,js,mjs,css}",
    "lint": "eslint --fix app domain infra",
    "prisma:generate": "prisma generate",
    "start": "next start",
    "test:domain": "glob -c 'node --test --no-warnings --import tsx' './domain/__tests__/**.ts'",
    "test:infra": "glob -c 'node --env-file=.env.test --test --no-warnings --import tsx' './infra/__tests__/**.ts'",
    "test:db-setup": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script | prisma db execute --stdin --url 'file:./prisma/test.db'"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@libsql/client": "^0.15.8",
    "@prisma/adapter-libsql": "^6.8.2",
    "@prisma/client": "^6.8.2",
    "@radix-ui/react-popover": "^1.1.14",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "next": "^16.2.9",
    "prisma": "^6.8.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.56.4",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.1",
    "remark-gfm": "^4.0.1",
    "search-summary": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "eslint": "^9.27.0",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.5",
    "glob": "^11.0.2",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwind-merge": "^3.3.0",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  }
}
